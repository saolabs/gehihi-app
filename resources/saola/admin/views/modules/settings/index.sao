<script setup lang="ts">
import { GehihiClient } from '@web/app/services/GehihiClient';
import { renderMarkdown } from '@web/app/services/Markdown';
@state(vm: any = { temporary: false, history: [], availableFiles: [], typeOptions: [], loading: true, busy: false, locale: 'vi', theme: 'system', error: '', notice: '', workspace: {}, user: null, projects: [], conversations: [], files: [], catalog: [], models: [], providers: [], providerTypes: {}, conversation: null, project: null, visibleMessages: [], run: null, mode: 'chat', thinking: 'auto', selectedModel: '', searchProvider: '', selectedFiles: [], modal: '', editProvider: {}, editProject: {}, systemProviders: false, probe: null, search: '', archived: false, mobileNav: false, usage: {}, sourcePanel: false, advanced: false, fallbacks: [], includeDomains: '', excludeDomains: '', language: 'vi', country: 'vn', import_available: false, resetToken: '', resetEmail: '' })
@state(prompt: string = '')
let client: GehihiClient;
function mounted() { client = new GehihiClient(setVm); client.load(); }
function unmounted() { client?.destroy(); }
function ghText(locale: string, vi: string, en: string) { return locale === 'en' ? en : vi; }
function authTitle(locale: string, modal: string) { if (modal === 'register') return ghText(locale, 'Chào mừng đến với Gehihi', 'Welcome to Gehihi'); if (modal === 'forgot' || modal === 'reset') return ghText(locale, 'Khôi phục tài khoản', 'Recover your account'); return ghText(locale, 'Tiếp nối những ý tưởng', 'Pick up where you left off'); }
function hasSources(run: any) { return !!run?.sources?.length; }
function conversationTitle(conversation: any) { return conversation?.title || ''; }
function initial(name: string) { return name.charAt(0).toUpperCase(); }
function kilobytes(size: number) { return Math.ceil(size / 1024); }
function probeLabel(result: any) { return result.key ? `Key ${result.key} · ` : ''; }
function probeResult(result: any) { return result.ok ? `✓ ${result.text} · ${result.latency_ms} ms` : result.message; }
function md(value: string) { return renderMarkdown(value); }
function value(event: Event) { return (event.target as HTMLInputElement).value; }
function patch(key: string, event: Event) { client.patch({ [key]: value(event) }); }
async function send(event: Event) { event.preventDefault(); if (await client.send(prompt)) setPrompt(''); }
function keydown(event: KeyboardEvent) {
    if (event.key === 'Escape') client?.close();
    if (event.key === 'Tab' && vm.modal) {
        const items = Array.from(document.querySelectorAll<HTMLElement>('[role="dialog"] button:not([disabled]), [role="dialog"] input, [role="dialog"] textarea, [role="dialog"] select, [role="dialog"] a'));
        const first = items[0], last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
}
function composerKey(event: KeyboardEvent) { if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) { event.preventDefault(); send(event); } }
function sample(text: string, mode: string) { setPrompt(text); client.patch({ mode }); document.getElementById('prompt')?.focus(); }
function editMessage(message: any) { setPrompt(message.content); client.patch({ conversation: { ...vm.conversation, selected_leaf_id: message.parent_id } }); document.getElementById('prompt')?.focus(); }
function historyItems() { return client ? client.historyItems() : []; }
function availableFiles() { return client ? client.availableFiles() : []; }
function siblings(message: any) { return client.siblings(message); }
function providerType(event: Event) { const type = value(event); const form = (event.target as HTMLElement).closest('form') as HTMLFormElement; const data = client.providerData(form); client.patch({ editProvider: { ...vm.editProvider, ...data, type, base_url: vm.providerTypes[type]?.base || '' } }); }
</script>
@await
<template>
@extends(__layout__ + "base")
@section('meta:title', 'Gehihi · Không gian cho những ý tưởng')
@block('content')
<div class="app-shell {{ vm['conversation'] ? 'is-conversation' : 'is-welcome' }} {{ vm['mobileNav'] ? 'nav-open' : '' }}" @keydown(keydown(event))>
    <aside class="sidebar" aria-label="Điều hướng">
        <a href="/" class="brand" data-nav="false"><span class="brand-mark">✦</span> gehihi<span class="brand-dot">.</span></a>
        <button class="new-chat" @click(client.newChat())><span>＋</span>{{ ghText(vm['locale'],'Cuộc trò chuyện mới','New conversation') }}<kbd>↗</kbd></button>
        <label class="search-box"><span>⌕</span><input aria-label="Tìm hội thoại" type="search" placeholder="{{ ghText(vm['locale'],'Tìm cuộc trò chuyện…','Search conversations…') }}" value="{{ vm['search'] }}" @change(client.search(value(event)))><kbd>⌘ K</kbd></label>
        <div class="nav-section-title"><span>{{ ghText(vm['locale'],'DỰ ÁN CỦA BẠN','YOUR PROJECTS') }}</span><button class="icon-button" aria-label="Tạo dự án" @click(client.patch({ modal: 'project', editProject: {} }))>＋</button></div>
        <nav class="projects-list">
            @foreach(vm['projects'] as p)
            @key(p.id)
            @if(!p.archived)
            <button class="nav-item {{ (vm['project'] ? vm['project']['id'] : null) === p.id ? 'active' : '' }}" @click(client.showProject(p))><span class="folder-icon">▱</span><span>{{ p.name }}</span><small>↗</small></button>
            @endif
            @endforeach
            @if(vm['projects'].length === 0)
            <button class="empty-project" @click(client.patch({ modal: 'project', editProject: {} }))>{{ ghText(vm['locale'],'Một nơi cho từng ý tưởng','A space for every idea') }}<span>{{ ghText(vm['locale'],'Tạo dự án đầu tiên →','Create your first project →') }}</span></button>
            @endif
        </nav>
        <div class="nav-section-title history-heading"><span>{{ vm['archived'] ? ghText(vm['locale'],'ĐÃ LƯU TRỮ','ARCHIVED') : ghText(vm['locale'],'GẦN ĐÂY','RECENT') }}</span><button class="icon-button" title="Đổi danh sách lưu trữ" @click(client.patch({ archived: !vm['archived'] }))>◷</button></div>
        <nav class="history-list" aria-label="Các cuộc trò chuyện">
            @foreach(vm['history'] as c)
            @key(c.id)
            <button class="history-item {{ vm['conversation']['id'] === c.id ? 'selected' : '' }}" @click(client.open(c.id))><span>{{ c.pinned ? '⌖ ' : '' }}{{ c.title }}</span></button>
            @endforeach
            @if(vm['conversations'].length === 0)
            <p class="muted-caption">{{ ghText(vm['locale'],'Những cuộc trò chuyện hay bắt đầu từ một câu hỏi.','Good conversations begin with a question.') }}</p>
            @endif
        </nav>
        <div class="sidebar-bottom">
            <div class="guest-card"><span class="status-dot"></span><div><strong>{{ vm['user'] ? vm['user']['name'] : ghText(vm['locale'],'Không gian của bạn','Your space') }}</strong><small>{{ vm['user'] ? ghText(vm['locale'],'Đã đồng bộ tài khoản','Synced to your account') : ghText(vm['locale'],'Bắt đầu ngay, không cần tài khoản','Start freely, no account needed') }}</small></div></div>
            <button class="profile-row" @click(client.settings())><span class="avatar">{{ vm['user'] ? initial(vm['user']['name']) : 'G' }}</span><span>{{ vm['user'] ? vm['user']['name'] : ghText(vm['locale'],'Bạn đang dùng với tư cách khách','Browsing as a guest') }}</span><span class="settings-glyph">⚙</span></button>
        </div>
    </aside>
    <main class="main-panel">
        <header class="topbar">
            <div class="breadcrumb"><button class="icon-button mobile-toggle" aria-label="Mở thanh bên" @click(client.patch({ mobileNav: !vm['mobileNav'] }))>☰</button><span class="workspace-icon">▧</span><button class="breadcrumb-home" @click(client.newChat())>{{ ghText(vm['locale'],'Không gian làm việc','Workspace') }}</button><span class="breadcrumb-slash">/</span><span>{{ vm['project'] ? vm['project']['name'] : ghText(vm['locale'],'Khám phá','Explore') }}</span></div>
            <div class="topbar-actions"><button class="quiet-button" @click(client.newChat(null, true))>◌ <span>{{ ghText(vm['locale'],'Chat tạm thời','Temporary chat') }}</span></button><button class="icon-button" aria-label="Cài đặt" @click(client.settings())>⚙</button></div>
        </header>
        @if(vm['error'])
        <div class="toast error" role="alert"><span>{{ vm['error'] }}</span><button aria-label="Đóng lỗi" @click(client.patch({ error: '' }))>×</button></div>
        @endif
        @if(vm['notice'])
        <div class="toast notice" role="status"><span>{{ vm['notice'] }}</span><button aria-label="Đóng thông báo" @click(client.patch({ notice: '' }))>×</button></div>
        @endif
        @if(vm['import_available'])
        <div class="import-banner">{{ ghText(vm['locale'],'Bạn có dữ liệu từ phiên khách trước.','You have data from your previous guest session.') }}<button @click(client.importGuest())>{{ ghText(vm['locale'],'Nhập vào tài khoản','Import to account') }}</button><button @click(client.patch({ import_available: false }))>×</button></div>
        @endif
        @if(vm['project'])
        <div class="project-strip"><span class="project-badge">▱ {{ vm['project']['name'] }}</span><span>{{ ghText(vm['locale'],'Hướng dẫn chung','Shared instructions') }} · v{{ vm['project']['revision'] }}</span><button @click(client.patch({ modal: 'project', editProject: vm['project'] }))>{{ ghText(vm['locale'],'Xem & chỉnh sửa','View & edit') }} ↗</button><button @click(client.patch({ modal: 'sources' }))>{{ ghText(vm['locale'],'Nguồn dự án','Project sources') }}</button></div>
        @endif
        @if(vm['conversation'])
        <div class="conversation-toolbar"><h1>{{ vm['conversation']['title'] }}</h1><div><button title="Đổi tên" @click(client.conversationAction('rename'))>✎</button><button title="Ghim" @click(client.conversationAction('pin'))>⌖</button><button title="Lưu trữ" @click(client.conversationAction('archive'))>▣</button><a href="/api/conversations/{{ vm['conversation']['id'] }}/export" title="Xuất Markdown" data-nav="false">↓</a><a href="/api/conversations/{{ vm['conversation']['id'] }}/export?format=json" title="Xuất JSON" data-nav="false">{ }</a><button title="Xóa hội thoại" @click(client.conversationAction('delete'))>×</button></div><select aria-label="Chuyển hội thoại sang dự án" value="{{ vm['conversation']['project_id'] || '' }}" @change(client.moveConversation(value(event)))><option value="">{{ ghText(vm['locale'],'Ngoài dự án','Outside a project') }}</option>@foreach(vm['projects'] as p)<option value="{{ p.id }}">{{ p.name }}</option>@endforeach</select></div>
        @endif
        <div class="conversation-scroll {{ vm['conversation'] ? 'has-conversation' : '' }}">
            @if(!vm['conversation'])
            <section class="welcome">
                <div class="welcome-symbol" aria-hidden="true"><svg viewBox="0 0 88 88" fill="none"><path d="M44 8c3 20 14 32 36 36-22 4-33 16-36 36-4-20-15-32-36-36C29 40 40 28 44 8Z" fill="url(#gehihi-gradient)"/><path d="M61 9c1 8 5 12 13 13-8 2-12 6-13 13-2-7-6-11-13-13 7-1 11-5 13-13Z" fill="#b5a4e1"/><defs><linearGradient id="gehihi-gradient" x1="13" y1="15" x2="69" y2="76"><stop stop-color="#a9cfc5"/><stop offset=".52" stop-color="#9282cd"/><stop offset="1" stop-color="#6653a7"/></linearGradient></defs></svg></div>
                <span class="eyebrow">{{ ghText(vm['locale'],'MỘT CHÚT TÒ MÒ. VÔ VÀN KHẢ NĂNG.','A LITTLE CURIOSITY. ENDLESS POSSIBILITY.') }}</span>
                <h1>{{ vm['project'] ? vm['project']['name'] : ghText(vm['locale'],'Ý tưởng tiếp theo của bạn là gì?','What’s your next idea?') }}</h1>
                <p>{{ ghText(vm['locale'],'Cùng trò chuyện, tìm hiểu và biến những điều bạn nghĩ thành điều có thể.','Let’s talk, explore, and turn what’s on your mind into what’s possible.') }}</p>
                @if(vm['temporary'])<span class="temporary-label">◌ {{ ghText(vm['locale'],'Cuộc trò chuyện tạm thời · tự dọn sau 24 giờ','Temporary conversation · cleared after 24 hours') }}</span>@endif
                <div class="suggestions">
                    <button @click(sample('Tìm hiểu các xu hướng ứng dụng AI trong giáo dục tại Việt Nam, dẫn nguồn đáng tin cậy.', 'quick'))><span class="suggestion-icon green">⌕</span><strong>{{ ghText(vm['locale'],'Khám phá một chủ đề','Explore a topic') }}</strong><small>{{ ghText(vm['locale'],'Tìm câu trả lời từ những nguồn thực tế','Find answers grounded in real sources') }}</small><span class="card-arrow">↗</span></button>
                    <button @click(sample('Nghiên cứu các giải pháp lưu trữ dữ liệu cho một ứng dụng nhỏ, so sánh ưu nhược điểm và đưa ra gợi ý có nguồn.', 'deep'))><span class="suggestion-icon purple">✧</span><strong>{{ ghText(vm['locale'],'Nghiên cứu sâu hơn','Go a little deeper') }}</strong><small>{{ ghText(vm['locale'],'Kết nối thông tin, nhìn thấy bức tranh lớn','Connect the dots and see the bigger picture') }}</small><span class="card-arrow">↗</span></button>
                    <button @click(sample('Giúp tôi phát triển ý tưởng cho một dự án mới. Hãy bắt đầu bằng việc hỏi điều tôi muốn giải quyết.', 'chat'))><span class="suggestion-icon orange">☼</span><strong>{{ ghText(vm['locale'],'Khơi nguồn ý tưởng','Make room for ideas') }}</strong><small>{{ ghText(vm['locale'],'Một góc nhìn mới cho điều bạn đang nghĩ','A fresh perspective on what’s on your mind') }}</small><span class="card-arrow">↗</span></button>
                </div>
            </section>
            @else
            <section class="messages" aria-label="Nội dung hội thoại" aria-live="polite">
                @foreach(vm['visibleMessages'] as message)
                @key(message.id)
                <article class="message {{ message.role === 'user' ? 'user-message' : 'assistant-message' }}">
                    <div class="message-avatar">{{ message.role === 'user' ? ghText(vm['locale'],'Bạn','You') : '✦' }}</div>
                    <div class="message-body"><div class="message-label">{{ message.role === 'user' ? ghText(vm['locale'],'Bạn','You') : 'Gehihi' }} @if(message.metadata?.model)<span>{{ message.metadata.model.model_id }}</span>@endif</div>
                        @if(message.role === 'user')<div class="user-content">{{ message.content }}</div>@else<div class="markdown">{!! md(message.content) !!}</div>@endif
                        @if(!message.content && message.role === 'assistant')<div class="typing-indicator"><i></i><i></i><i></i></div>@endif
                        @if(message.metadata?.error)<p class="inline-error">{{ message.metadata.error }}</p>@endif
                        <div class="message-actions"><button @click(client.copy(message.content))>{{ ghText(vm['locale'],'Sao chép','Copy') }}</button>@if(message.role === 'user')<button @click(editMessage(message))>{{ ghText(vm['locale'],'Sửa câu hỏi','Edit') }}</button>@else<button @click(client.send('', { regenerate_id: message.id }))>{{ ghText(vm['locale'],'Tạo lại','Regenerate') }}</button>@endif
                            @if(siblings(message).length > 1)<span class="branch-picker">@foreach(siblings(message) as sibling)<button class="{{ sibling.id === message.id ? 'selected' : '' }}" @click(client.chooseBranch(sibling.id))>{{ siblings(message).indexOf(sibling) + 1 }}</button>@endforeach</span>@endif
                        </div>
                    </div>
                </article>
                @endforeach
                @if(vm['run'])
                <div class="run-status {{ vm['run']['status'] }}"><span class="status-dot"></span><span>{{ vm['run']['progress'] }}</span>@if(hasSources(vm['run']))<button @click(client.patch({ sourcePanel: !vm['sourcePanel'] }))>{{ vm['run']['sources'].length }} {{ ghText(vm['locale'],'nguồn','sources') }} ↗</button>@endif</div>
                @if(vm['run']['error'])<p class="inline-error">{{ vm['run']['error'] }}</p>@endif
                @if(vm['run']['stop_reason'])<p class="muted-caption">{{ vm['run']['stop_reason'] }}</p>@endif
                @if(vm['run']['context_truncated'])<p class="muted-caption">{{ ghText(vm['locale'],'Một phần lịch sử đã được rút gọn để vừa ngữ cảnh model. Hướng dẫn dự án được giữ nguyên.','Some history was shortened to fit the model context. Project instructions are retained.') }}</p>@endif
                @if(vm['run']['can_resume'])<button class="resume-button" @click(client.resume())>{{ ghText(vm['locale'],'Tiếp tục nghiên cứu từ dữ liệu đã lưu','Continue from saved research') }} →</button>@endif
                @if(vm['sourcePanel'])<div class="source-grid">@foreach(vm['run']['sources'] || [] as source)<a class="source-card" href="{{ source.url || '#' }}" target="_blank" rel="noopener noreferrer nofollow" data-nav="false"><span>{{ source.id }}</span><strong>{{ source.title }}</strong><small>{{ source.kind === 'page_content' ? ghText(vm['locale'],'Đã đọc trang','Page read') : ghText(vm['locale'],'Nguồn một phần','Partial source') }}</small><small>{{ source.observed_at }}</small></a>@endforeach</div>@endif
                @endif
            </section>
            @endif
        </div>
        <section class="composer-region {{ vm['conversation'] ? 'bottom-composer' : '' }}">
            <div class="mode-tabs" aria-label="Chế độ trả lời"><button class="{{ vm['mode'] === 'chat' ? 'active' : '' }}" @click(client.patch({ mode: 'chat' }))>◌ {{ ghText(vm['locale'],'Trò chuyện','Chat') }}</button><button class="{{ vm['mode'] === 'quick' ? 'active' : '' }}" @click(client.patch({ mode: 'quick' }))>⌕ {{ ghText(vm['locale'],'Tra cứu web','Web search') }}</button><button class="{{ vm['mode'] === 'deep' ? 'active' : '' }}" @click(client.patch({ mode: 'deep' }))>✧ {{ ghText(vm['locale'],'Nghiên cứu sâu','Research') }}</button></div>
            <form class="composer" @submit(send(event))>
                @if(vm['selectedFiles'].length)<div class="attachment-chips">@foreach(vm['files'] as file)@if(vm['selectedFiles'].includes(file.id))<button type="button" @click(client.toggleFile(file.id))>▧ {{ file.name }} ×</button>@endif@endforeach</div>@endif
                <textarea id="prompt" aria-label="Nhập câu hỏi" @bind(prompt) @keydown(composerKey(event)) rows="3" maxlength="14000" placeholder="{{ vm['mode'] === 'deep' ? ghText(vm['locale'],'Bạn muốn nghiên cứu điều gì?','What would you like to research?') : ghText(vm['locale'],'Hỏi bất cứ điều gì, hoặc bắt đầu một ý tưởng…','Ask anything, or start with an idea…') }}"></textarea>
                <div class="composer-toolbar"><div class="composer-tools"><label class="attach-button" title="Tải tệp lên"><span>＋</span><input type="file" multiple aria-label="Tải tệp lên" @change(client.upload(event)) accept=".pdf,.txt,.md,.csv,.tsv,.json,.php,.js,.ts,.py,.html,.css,.png,.jpg,.jpeg,.webp"></label><button type="button" class="source-picker" @click(client.patch({ modal: 'sources' }))>▧ <span>{{ ghText(vm['locale'],'Nguồn','Sources') }}</span></button><span class="toolbar-divider"></span><select aria-label="Chọn model" value="{{ vm['selectedModel'] }}" @change(patch('selectedModel', event))><option value="">{{ ghText(vm['locale'],'Model mặc định','Default model') }}</option>@foreach(vm['models'] as model)<option value="{{ model.value }}">{{ model.label }}</option>@endforeach</select><button type="button" class="icon-button" aria-label="Tùy chọn nâng cao" @click(client.patch({ advanced: !vm['advanced'] }))>⚒</button></div>
                    @if(vm['run'] && ['queued','running'].includes(vm['run']['status']))<button class="send-button stop-button" type="button" @click(client.cancel()) aria-label="Dừng tạo câu trả lời">■</button>@else<button class="send-button" type="submit" disabled="{{ vm['busy'] || !prompt.trim() }}" aria-label="Gửi câu hỏi">↑</button>@endif
                </div>
            </form>
            @if(vm['advanced'])
            <div class="advanced-options"><label>{{ ghText(vm['locale'],'Chế độ','Mode') }}<select value="{{ vm['thinking'] }}" @change(patch('thinking',event))><option value="auto">{{ ghText(vm['locale'],'Tự động','Automatic') }}</option><option value="fast">{{ ghText(vm['locale'],'Nhanh','Fast') }}</option><option value="reasoning">{{ ghText(vm['locale'],'Model suy luận','Reasoning model') }}</option></select></label><label>{{ ghText(vm['locale'],'Model dự phòng đã cho phép','Allowed fallback model') }}<select value="{{ vm['fallbacks'][0] || '' }}" @change(client.patch({ fallbacks: [value(event)] }))><option value="">{{ ghText(vm['locale'],'Không tự chuyển provider','No automatic provider switch') }}</option>@foreach(vm['models'] as model)<option value="{{ model.value }}">{{ model.label }}</option>@endforeach</select></label>
                @if(vm['mode'] !== 'chat')<label>{{ ghText(vm['locale'],'Provider tìm kiếm','Search provider') }}<select value="{{ vm['searchProvider'] }}" @change(patch('searchProvider',event))><option value="">{{ ghText(vm['locale'],'Theo cấu hình mặc định','Configured defaults') }}</option>@foreach(vm['catalog'] as provider)@if(provider.kind === 'search')<option value="{{ provider.id }}">{{ provider.name }}</option>@endif@endforeach</select></label><label>{{ ghText(vm['locale'],'Ưu tiên domain','Include domains') }}<input value="{{ vm['includeDomains'] }}" @change(patch('includeDomains',event)) placeholder="example.com"></label><label>{{ ghText(vm['locale'],'Loại trừ domain','Exclude domains') }}<input value="{{ vm['excludeDomains'] }}" @change(patch('excludeDomains',event)) placeholder="example.com"></label><label>{{ ghText(vm['locale'],'Ngôn ngữ / thị trường','Language / country') }}<select value="{{ vm['language'] }}" @change(client.patch({ language: value(event), country: value(event) === 'vi' ? 'vn' : 'us' }))><option value="vi">Tiếng Việt / Việt Nam</option><option value="en">English / US</option></select></label>@endif
            </div>
            @endif
            <p class="composer-note">{{ ghText(vm['locale'],'Giữ sự tò mò. Kiểm tra những thông tin quan trọng.','Stay curious. Double-check important information.') }}<span>Gehihi {{ vm['mode'] === 'deep' ? 'Research' : 'AI' }}</span></p>
            @if(!vm['loading'] && vm['models'].length === 0)<p class="setup-note">{{ ghText(vm['locale'],'AI chưa được cấu hình.','AI is not configured yet.') }} <button @click(client.settings())>{{ ghText(vm['locale'],'Thêm provider để bắt đầu','Configure a provider to start') }} →</button></p>@endif
        </section>
        <footer class="workspace-footer"><span>✦ {{ ghText(vm['locale'],'Một không gian nhỏ, cho những ý tưởng lớn.','A little space for big ideas.') }}</span><span>{{ vm['user'] ? ghText(vm['locale'],'Không gian riêng tư','Private workspace') : ghText(vm['locale'],'Dữ liệu khách lưu tối đa 7 ngày','Guest data retained for up to 7 days') }}</span></footer>
    </main>
    @if(vm['modal'])
    <div class="modal-backdrop"><section class="modal {{ ['settings','provider','sources'].includes(vm['modal']) ? 'wide-modal' : '' }}" role="dialog" aria-modal="true" aria-label="{{ vm['modal'] }}"><button class="modal-close" aria-label="Đóng cửa sổ" @click(client.close())>×</button>
        @if(vm['modal'] === 'project')
        <span class="eyebrow">PROJECT SPACE</span><h2>{{ vm['editProject']['id'] ? ghText(vm['locale'],'Chỉnh sửa dự án','Edit project') : ghText(vm['locale'],'Một nơi cho ý tưởng của bạn','A home for your idea') }}</h2><p class="modal-description">{{ ghText(vm['locale'],'Hướng dẫn này được nạp vào mọi lượt trò chuyện trong dự án.','These instructions apply to every conversation turn in this project.') }}</p>
        <form @submit(client.projectForm(event))><label>{{ ghText(vm['locale'],'Tên dự án','Project name') }}<input name="name" required maxlength="120" value="{{ vm['editProject']['name'] || '' }}" placeholder="Ví dụ: Kế hoạch ra mắt sản phẩm"></label><label>{{ ghText(vm['locale'],'Hướng dẫn chung','Shared instructions') }}<textarea name="instructions" rows="7" maxlength="14000" placeholder="Mục tiêu, bối cảnh, cách trả lời bạn mong muốn…">{{ vm['editProject']['instructions'] }}</textarea></label><div class="form-footer">@if(vm['editProject']['id'])<button type="button" class="danger-button" @click(client.removeProject(vm['editProject']))>{{ ghText(vm['locale'],'Xóa dự án','Delete project') }}</button>@endif<button class="primary-button" disabled="{{ vm['busy'] }}">{{ ghText(vm['locale'],'Lưu dự án','Save project') }} →</button></div></form>
        @elseif(vm['modal'] === 'sources')
        <span class="eyebrow">SOURCES</span><h2>{{ ghText(vm['locale'],'Mang theo ngữ cảnh của bạn','Bring your context along') }}</h2><p class="modal-description">{{ ghText(vm['locale'],'Chọn tối đa 5 tệp cho lượt tiếp theo. Dữ liệu được gửi tới provider bạn chọn.','Choose up to 5 files for the next turn. Data is sent to your selected provider.') }}</p><div class="file-list">@foreach(vm['availableFiles'] as file)<div class="file-row"><label><input type="checkbox" checked="{{ vm['selectedFiles'].includes(file.id) }}" disabled="{{ !['ready','partial'].includes(file.status) }}" @change(client.toggleFile(file.id))><span><strong>{{ file.name }}</strong><small>{{ file.status }} · {{ kilobytes(file.size) }} KB {{ file.error || '' }}</small></span></label><a href="/api/files/{{ file.id }}/download" data-nav="false">↓</a><button aria-label="Xóa tệp" @click(client.removeFile(file.id))>×</button></div>@endforeach</div><label class="upload-zone">＋ {{ ghText(vm['locale'],'Tải tệp từ máy tính','Upload from your computer') }}<input type="file" multiple aria-label="Chọn tệp" @change(client.upload(event))></label><p class="muted-caption">PDF văn bản, TXT, Markdown, CSV, code và ảnh · tối đa 10 MB/tệp. PDF scan cần OCR.</p>
        @elseif(vm['modal'] === 'settings')
        <span class="eyebrow">YOUR SPACE, YOUR WAY</span><h2>{{ vm['systemProviders'] ? ghText(vm['locale'],'Cấu hình hệ thống','System configuration') : ghText(vm['locale'],'Cài đặt không gian','Workspace settings') }}</h2>
        <div class="settings-account"><span class="avatar">{{ vm['user'] ? initial(vm['user']['name']) : 'G' }}</span><div><strong>{{ vm['user'] ? vm['user']['name'] : ghText(vm['locale'],'Bạn đang sử dụng với tư cách khách','You’re browsing as a guest') }}</strong><small>{{ vm['user'] ? vm['user']['email'] : ghText(vm['locale'],'Đăng nhập để đồng bộ và thêm provider riêng.','Sign in to sync and add your own providers.') }}</small></div>@if(vm['user'])<button class="quiet-button" @click(client.logout())>{{ ghText(vm['locale'],'Đăng xuất','Sign out') }}</button>@else<button class="primary-button" @click(client.patch({ modal: 'login' }))>{{ ghText(vm['locale'],'Đăng nhập','Sign in') }}</button>@endif</div>
        <div class="settings-appearance"><label>{{ ghText(vm['locale'],'Giao diện','Appearance') }}<select value="{{ vm['theme'] }}" @change(client.preference('theme',value(event)))><option value="system">{{ ghText(vm['locale'],'Theo thiết bị','System') }}</option><option value="light">{{ ghText(vm['locale'],'Sáng','Light') }}</option><option value="dark">{{ ghText(vm['locale'],'Tối','Dark') }}</option></select></label><label>{{ ghText(vm['locale'],'Ngôn ngữ','Language') }}<select value="{{ vm['locale'] }}" @change(client.preference('locale',value(event)))><option value="vi">Tiếng Việt</option><option value="en">English</option></select></label></div>
        @if(vm['user'])
        <div class="settings-heading"><h3>{{ vm['systemProviders'] ? ghText(vm['locale'],'Provider dùng chung','Shared providers') : ghText(vm['locale'],'Provider của bạn','Your providers') }}</h3><button class="small-button" @click(client.editProvider())>＋ {{ ghText(vm['locale'],'Thêm provider','Add provider') }}</button></div>
        @if(vm['user']['is_admin'])<div class="scope-tabs"><button class="{{ !vm['systemProviders'] ? 'active' : '' }}" @click(client.settings(false))>{{ ghText(vm['locale'],'Cá nhân','Personal') }}</button><button class="{{ vm['systemProviders'] ? 'active' : '' }}" @click(client.settings(true))>{{ ghText(vm['locale'],'Hệ thống','System') }}</button></div>@endif
        <div class="provider-list">@foreach(vm['providers'] as provider)<div class="provider-row"><span class="provider-icon">{{ provider.kind === 'search' ? '⌕' : '✦' }}</span><div><strong>{{ provider.name }}</strong><small>{{ provider.type }} · {{ provider.key_count }} key · {{ provider.models.length }} model · {{ provider.enabled ? ghText(vm['locale'],'Đang bật','Enabled') : ghText(vm['locale'],'Đã tắt','Disabled') }}</small></div><button @click(client.editProvider(provider))>{{ ghText(vm['locale'],'Sửa','Edit') }}</button><button class="danger-button" @click(client.removeProvider(provider.id))>×</button></div>@endforeach</div>
        @if(vm['providers'].length === 0)<p class="empty-state-text">{{ ghText(vm['locale'],'Chưa có provider. Bạn có thể thêm model AI hoặc dịch vụ tìm kiếm.','No providers yet. Add an AI model or a search service.') }}</p>@endif
        <p class="muted-caption">{{ ghText(vm['locale'],'Key được mã hóa, không gửi trở lại trình duyệt. Model tổng hợp và provider tìm kiếm được quản lý độc lập.','Keys are encrypted and never returned to the browser. Language models and search services are configured independently.') }}</p>
        <div class="usage-summary"><span>{{ ghText(vm['locale'],'Sử dụng hôm nay','Today’s usage') }}</span><strong>{{ vm['usage']['runs_today'] || 0 }} {{ ghText(vm['locale'],'lượt','runs') }} · {{ vm['usage']['tokens_today'] || 0 }} tokens</strong><small>{{ ghText(vm['locale'],'Token có thể gồm số ước tính khi provider không báo usage.','May include estimates when a provider does not report usage.') }}</small></div>
        @endif
        @elseif(vm['modal'] === 'provider')
        <span class="eyebrow">PROVIDERS</span><h2>{{ vm['editProvider']['id'] ? ghText(vm['locale'],'Chỉnh sửa provider','Edit provider') : ghText(vm['locale'],'Kết nối sức mạnh của bạn','Connect your possibilities') }}</h2><p class="modal-description">{{ vm['systemProviders'] ? ghText(vm['locale'],'Provider hệ thống phục vụ cả khách chưa đăng nhập.','System providers are available to guests too.') : ghText(vm['locale'],'Cấu hình riêng, chỉ tài khoản của bạn được sử dụng.','Your configuration is available only to your account.') }}</p>
        <form @submit(client.saveProvider(event))><div class="two-columns"><label>{{ ghText(vm['locale'],'Tên hiển thị','Display name') }}<input name="name" required value="{{ vm['editProvider']['name'] || '' }}"></label><label>{{ ghText(vm['locale'],'Nhà cung cấp','Provider type') }}<select name="type" value="{{ vm['editProvider']['type'] || 'google' }}" @change(providerType(event))>@foreach(vm['typeOptions'] as type)<option value="{{ type.value }}">{{ type.label }}</option>@endforeach</select></label></div><label>Base URL<input name="base_url" value="{{ vm['editProvider']['base_url'] || '' }}" placeholder="{{ vm['providerTypes'][vm['editProvider']['type']]['base'] || 'https://…' }}"></label><label>API keys <small>{{ ghText(vm['locale'],'Mỗi key một dòng. Để trống để giữ key đã lưu.','One key per line. Leave blank to keep saved keys.') }}</small><textarea name="api_keys" rows="2" autocomplete="off" spellcheck="false" placeholder="{{ vm['editProvider']['key_count'] ? '•••• Đã lưu key' : 'API key' }}">{{ vm['editProvider']['api_keys'] }}</textarea></label>
        @if(vm['providerTypes'][vm['editProvider']['type']]['kind'] === 'llm')<label>{{ ghText(vm['locale'],'Model được phép dùng','Allowed model IDs') }}<textarea name="models" rows="4" placeholder="{{ ghText(vm['locale'],'Mỗi model ID một dòng','One model ID per line') }}">{{ vm['editProvider']['models'] }}</textarea></label><label>{{ ghText(vm['locale'],'Model mặc định','Default model') }}<input name="default_model" value="{{ vm['editProvider']['default_model'] || '' }}" placeholder="{{ ghText(vm['locale'],'Để trống chọn model đầu tiên','Leave blank to use the first model') }}"></label><div class="two-columns"><label>{{ ghText(vm['locale'],'Model nhận ảnh','Vision model IDs') }}<textarea name="vision_models" rows="2" placeholder="{{ ghText(vm['locale'],'Chỉ model ID đã xác nhận nhận ảnh','Only verified vision model IDs') }}">{{ vm['editProvider']['vision_models'] }}</textarea></label><label>{{ ghText(vm['locale'],'Model suy luận','Reasoning model IDs') }}<textarea name="reasoning_models" rows="2" placeholder="{{ ghText(vm['locale'],'Chỉ model ID hỗ trợ suy luận','Only reasoning-capable model IDs') }}">{{ vm['editProvider']['reasoning_models'] }}</textarea></label></div>@endif
        <div class="checkboxes"><label><input type="checkbox" name="enabled" checked="{{ vm['editProvider']['enabled'] }}">{{ ghText(vm['locale'],'Bật provider','Enable provider') }}</label><label><input type="checkbox" name="is_default" checked="{{ vm['editProvider']['is_default'] }}">{{ ghText(vm['locale'],'Ưu tiên mặc định','Preferred default') }}</label><label><input type="checkbox" name="clear_keys">{{ ghText(vm['locale'],'Xóa key đã lưu','Clear saved keys') }}</label></div>
        @if(vm['probe'])<div class="probe-results">@if(vm['probe']['message'])<p>{{ vm['probe']['message'] }}</p>@endif @foreach(vm['probe']['results'] || [] as result)<p class="{{ result.ok ? 'test-ok' : 'test-error' }}">{{ probeLabel(result) }}{{ probeResult(result) }}</p>@endforeach</div>@endif
        <div class="form-footer">@if(vm['providerTypes'][vm['editProvider']['type']]['kind'] === 'llm')<button type="button" class="small-button" disabled="{{ vm['busy'] }}" @click(client.probe(event,'discover'))>{{ ghText(vm['locale'],'Tải model','Load models') }}</button>@endif<button type="button" class="small-button" disabled="{{ vm['busy'] }}" @click(client.probe(event,'test'))>{{ ghText(vm['locale'],'Kiểm tra','Test') }}</button><button class="primary-button" disabled="{{ vm['busy'] }}">{{ vm['busy'] ? ghText(vm['locale'],'Đang xử lý…','Working…') : ghText(vm['locale'],'Lưu provider','Save provider') }} →</button></div></form>
        @elseif(vm['modal'] === 'rename')
        <h2>{{ ghText(vm['locale'],'Đổi tên cuộc trò chuyện','Rename conversation') }}</h2><form @submit(client.rename(event))><label>{{ ghText(vm['locale'],'Tên hội thoại','Conversation title') }}<input name="title" required maxlength="180" value="{{ conversationTitle(vm['conversation']) }}"></label><button class="primary-button">{{ ghText(vm['locale'],'Lưu','Save') }}</button></form>
        @elseif(['login','register','forgot','reset'].includes(vm['modal']))
        <span class="brand mini-brand"><span class="brand-mark">✦</span> gehihi.</span><h2>{{ authTitle(vm['locale'],vm['modal']) }}</h2><p class="modal-description">{{ ghText(vm['locale'],'Dự án, hội thoại và provider của bạn ở cùng một nơi.','Your projects, conversations, and providers in one place.') }}</p><form @submit(client.auth(event,vm['modal']))>
        @if(vm['modal'] === 'register')<label>{{ ghText(vm['locale'],'Tên của bạn','Your name') }}<input name="name" autocomplete="name" required maxlength="100"></label>@endif
        <label>Email<input type="email" name="email" autocomplete="email" required value="{{ vm['modal'] === 'reset' ? vm['resetEmail'] : '' }}"></label>
        @if(vm['modal'] !== 'forgot')<label>{{ ghText(vm['locale'],'Mật khẩu','Password') }}<input type="password" name="password" required minlength="{{ vm['modal'] === 'login' ? 1 : 12 }}" autocomplete="{{ vm['modal'] === 'login' ? 'current-password' : 'new-password' }}"></label>@endif
        @if(vm['modal'] === 'reset')<input type="hidden" name="token" value="{{ vm['resetToken'] }}"><label>{{ ghText(vm['locale'],'Nhập lại mật khẩu','Confirm password') }}<input type="password" name="password_confirmation" required autocomplete="new-password"></label>@endif
        <button class="primary-button full-width" disabled="{{ vm['busy'] }}">{{ ghText(vm['locale'],'Tiếp tục','Continue') }} →</button></form>
        <div class="auth-links">@if(vm['modal'] === 'login')<button @click(client.patch({ modal: 'register' }))>{{ ghText(vm['locale'],'Tạo tài khoản miễn phí','Create a free account') }}</button><button @click(client.patch({ modal: 'forgot' }))>{{ ghText(vm['locale'],'Quên mật khẩu?','Forgot password?') }}</button>@else<button @click(client.patch({ modal: 'login' }))>{{ ghText(vm['locale'],'Quay lại đăng nhập','Back to sign in') }}</button>@endif</div>
        @endif
        @if(vm['error'])<p class="inline-error" role="alert">{{ vm['error'] }}</p>@endif
    </section></div>
    @endif
</div>
@endblock
</template>
