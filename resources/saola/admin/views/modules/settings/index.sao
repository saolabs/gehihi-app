<script setup lang="ts">
import { AdminClient } from '@admin/app/services/AdminClient';
@state(vm: any = { tab: 'overview', loading: true, busy: false, error: '', notice: '', me: null, days: 30, overview: null, providers: null, users: [], q: '', limits: [], mobileNav: false })
let client: AdminClient;
function mounted() { client = new AdminClient(setVm); client.load(); }
function unmounted() { client?.destroy(); }
function value(event: Event) { return (event.target as HTMLInputElement).value; }
</script>
@await
<template>
@extends(__layout__ + "base")
@section('meta:title', 'Quản trị · Gehihi')
@block('content')
<div class="app-shell adm-shell {{ vm['mobileNav'] ? 'nav-open' : '' }}">
    <aside class="sidebar" aria-label="Điều hướng quản trị">
        <div class="sidebar-head">
            <a href="/admin" class="brand" data-nav="false"><img src="/assets/img/gehihi-mark.svg" width="30" height="30" alt=""><span>Gehihi</span><span class="adm-badge">Admin</span></a>
            <button class="icon-button sidebar-close" aria-label="Đóng thanh bên" @click(client.patch({ mobileNav: false }))><svg class="i" aria-hidden="true"><use href="#i-x"></use></svg></button>
        </div>
        <nav class="adm-nav">
            <button class="nav-item {{ vm['tab'] === 'overview' ? 'active' : '' }}" aria-current="{{ vm['tab'] === 'overview' ? 'page' : 'false' }}" @click(client.go('overview'))><svg class="i" aria-hidden="true"><use href="#i-chart"></use></svg><span>Tổng quan</span></button>
            <button class="nav-item {{ vm['tab'] === 'providers' ? 'active' : '' }}" aria-current="{{ vm['tab'] === 'providers' ? 'page' : 'false' }}" @click(client.go('providers'))><svg class="i" aria-hidden="true"><use href="#i-plug"></use></svg><span>Provider</span></button>
            <button class="nav-item {{ vm['tab'] === 'users' ? 'active' : '' }}" aria-current="{{ vm['tab'] === 'users' ? 'page' : 'false' }}" @click(client.go('users'))><svg class="i" aria-hidden="true"><use href="#i-users"></use></svg><span>Người dùng</span></button>
            <button class="nav-item {{ vm['tab'] === 'limits' ? 'active' : '' }}" aria-current="{{ vm['tab'] === 'limits' ? 'page' : 'false' }}" @click(client.go('limits'))><svg class="i" aria-hidden="true"><use href="#i-gauge"></use></svg><span>Hạn mức</span></button>
        </nav>
        <span class="spacer"></span>
        <a href="/" data-nav="false" class="nav-item"><svg class="i" aria-hidden="true"><use href="#i-arrow-left"></use></svg><span>Về trang trò chuyện</span></a>
        @if(vm['me'])
        <div class="profile-row"><span class="avatar">{{ vm['me']['initial'] }}</span><span class="profile-text"><strong>{{ vm['me']['name'] }}</strong><small>{{ vm['me']['email'] }}</small></span></div>
        @endif
    </aside>
    @if(vm['mobileNav'])<div class="sidebar-scrim" @click(client.patch({ mobileNav: false }))></div>@endif
    <main class="main-panel">
        <header class="topbar">
            <button class="icon-button mobile-toggle" aria-label="Mở thanh bên" @click(client.patch({ mobileNav: !vm['mobileNav'] }))><svg class="i" aria-hidden="true"><use href="#i-menu"></use></svg></button>
            <div class="topbar-title"><h1>{{ vm['tab'] === 'overview' ? 'Tổng quan' : (vm['tab'] === 'providers' ? 'Provider hệ thống' : (vm['tab'] === 'users' ? 'Người dùng' : 'Hạn mức sử dụng')) }}</h1></div>
            <div class="topbar-actions">
                @if(vm['tab'] === 'overview')
                <div class="mode-tabs" role="group" aria-label="Khoảng thời gian"><button class="{{ vm['days'] === 7 ? 'active' : '' }}" aria-pressed="{{ vm['days'] === 7 ? 'true' : 'false' }}" @click(client.setDays(7))>7 ngày</button><button class="{{ vm['days'] === 30 ? 'active' : '' }}" aria-pressed="{{ vm['days'] === 30 ? 'true' : 'false' }}" @click(client.setDays(30))>30 ngày</button><button class="{{ vm['days'] === 90 ? 'active' : '' }}" aria-pressed="{{ vm['days'] === 90 ? 'true' : 'false' }}" @click(client.setDays(90))>90 ngày</button></div>
                @endif
                <button class="icon-button" title="Tải lại" aria-label="Tải lại" disabled="{{ vm['busy'] }}" @click(client.go(vm['tab'], false))><svg class="i" aria-hidden="true"><use href="#i-refresh"></use></svg></button>
            </div>
        </header>
        @if(vm['error'])
        <div class="toast error" role="alert"><span>{{ vm['error'] }}</span><button aria-label="Đóng lỗi" @click(client.patch({ error: '' }))><svg class="i" aria-hidden="true"><use href="#i-x"></use></svg></button></div>
        @endif
        @if(vm['notice'])
        <div class="toast notice" role="status"><span>{{ vm['notice'] }}</span><button aria-label="Đóng thông báo" @click(client.patch({ notice: '' }))><svg class="i" aria-hidden="true"><use href="#i-x"></use></svg></button></div>
        @endif
        <div class="conversation-scroll adm-content {{ vm['busy'] ? 'is-busy' : '' }}">
            @if(vm['loading'])
            <p class="muted-caption adm-loading">Đang tải…</p>
            @endif

            @if(vm['tab'] === 'overview' && vm['overview'])
            <section class="adm-stats">
                @foreach(vm['overview']['stats'] as stat)
                @key(stat.id)
                <div class="adm-card adm-stat {{ stat.warn ? 'warn' : '' }}"><span class="adm-stat-label"><svg class="i" aria-hidden="true"><use href="{{ stat.icon }}"></use></svg>{{ stat.label }}</span><strong>{{ stat.value }}</strong><small>{{ stat.hint }}</small></div>
                @endforeach
            </section>
            <section class="adm-card">
                <div class="adm-card-head"><h2>Lượt chạy theo ngày</h2><span class="muted">{{ vm['overview']['active'] }} đang chạy · {{ vm['overview']['conversations'] }} hội thoại</span></div>
                <div class="adm-chart" role="img" aria-label="Biểu đồ số lượt chạy mỗi ngày, cao nhất {{ vm['overview']['peak'] }} lượt">
                    <span class="adm-chart-max">{{ vm['overview']['peak'] }}</span>
                    <div class="adm-bars">
                        @foreach(vm['overview']['bars'] as bar)
                        @key(bar.key)
                        <div class="adm-bar" tabindex="0" data-tip="{{ bar.tip }}" aria-label="{{ bar.tip }}"><i style="height: {{ bar.height }}%"></i><span>{{ bar.tick }}</span></div>
                        @endforeach
                    </div>
                </div>
            </section>
            <div class="adm-grid">
                <section class="adm-card">
                    <div class="adm-card-head"><h2>Theo chế độ</h2></div>
                    @foreach(vm['overview']['modes'] as mode)
                    @key(mode.mode)
                    <div class="adm-meter"><div class="adm-meter-row"><span>{{ mode.label }}</span><strong>{{ mode.count }}</strong></div><div class="adm-meter-track"><i style="width: {{ mode.pct }}%"></i></div></div>
                    @endforeach
                </section>
                <section class="adm-card">
                    <div class="adm-card-head"><h2>Model dùng nhiều</h2></div>
                    @foreach(vm['overview']['models'] as model)
                    @key(model.id)
                    <div class="adm-meter"><div class="adm-meter-row"><span>{{ model.name }}</span><strong>{{ model.count }} <small class="muted">· {{ model.tokensLabel }} token</small></strong></div><div class="adm-meter-track"><i style="width: {{ model.pct }}%"></i></div></div>
                    @endforeach
                    @if(vm['overview']['models'].length === 0)<p class="muted-caption">Chưa có lượt chạy nào trong khoảng này.</p>@endif
                </section>
            </div>
            <section class="adm-card">
                <div class="adm-card-head"><h2>Lỗi gần đây</h2></div>
                @if(vm['overview']['failures'].length === 0)<p class="muted-caption">Không có lượt lỗi nào. 🎉</p>@endif
                <div class="adm-list">
                    @foreach(vm['overview']['failures'] as failure)
                    @key(failure.id)
                    <div class="adm-list-row"><svg class="i danger-ink" aria-hidden="true"><use href="#i-alert"></use></svg><div><strong>{{ failure.error || 'Không rõ lỗi' }}</strong><small>{{ failure.meta }}</small></div></div>
                    @endforeach
                </div>
            </section>
            @endif

            @if(vm['tab'] === 'providers' && vm['providers'])
            <section class="adm-card">
                <div class="adm-card-head"><div><h2>Provider dùng chung</h2><p class="muted">Phục vụ khách và tài khoản chưa có provider riêng. Thống kê 7 ngày gần nhất.</p></div><a class="small-button primary" href="/?manage=system" data-nav="false"><svg class="i" aria-hidden="true"><use href="#i-pencil"></use></svg>Quản lý provider</a></div>
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <thead><tr><th>Provider</th><th>Trạng thái</th><th>Key</th><th>Model</th><th>Lượt 7 ngày</th><th>Tỉ lệ lỗi</th><th>Kiểm tra gần nhất</th></tr></thead>
                        <tbody>
                            @foreach(vm['providers']['system'] as p)
                            @key(p.id)
                            <tr><td><strong>{{ p.name }}</strong><small>{{ p.kindLabel }} · {{ p.type }}{{ p.is_default ? ' · mặc định' : '' }}</small></td><td><span class="adm-status {{ p.status }}"><i></i>{{ p.statusLabel }}</span></td><td>{{ p.keyLabel }}</td><td>{{ p.kind === 'search' ? '—' : p.models }}</td><td>{{ p.runs }}</td><td>{{ p.failRate }}</td><td><small>{{ p.test_status || '—' }}</small><small>{{ p.tested }}</small></td></tr>
                            @endforeach
                        </tbody>
                    </table>
                </div>
                @if(vm['providers']['system'].length === 0)<p class="empty-state-text">Chưa có provider hệ thống. Khách sẽ không chat được cho tới khi bạn thêm một provider mô hình AI.</p>@endif
            </section>
            <section class="adm-card adm-inline-note"><svg class="i" aria-hidden="true"><use href="#i-users"></use></svg><span>{{ vm['providers']['personal']['users'] }} tài khoản tự cấu hình {{ vm['providers']['personal']['providers'] }} provider riêng. Key cá nhân chỉ chủ tài khoản dùng được.</span></section>
            @endif

            @if(vm['tab'] === 'users')
            <section class="adm-card">
                <div class="adm-card-head"><label class="search-box adm-search"><svg class="i" aria-hidden="true"><use href="#i-search"></use></svg><input type="search" aria-label="Tìm người dùng" placeholder="Tìm theo tên hoặc email…" value="{{ vm['q'] }}" @change(client.searchUsers(value(event)))></label><span class="muted">{{ vm['users'].length }} tài khoản</span></div>
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <thead><tr><th>Người dùng</th><th>Tham gia</th><th>Hội thoại</th><th>Lượt 30 ngày</th><th>Token 30 ngày</th><th>Quyền</th></tr></thead>
                        <tbody>
                            @foreach(vm['users'] as u)
                            @key(u.id)
                            <tr><td><div class="adm-user"><span class="avatar">{{ u.initial }}</span><div><strong>{{ u.name }}{{ u.isMe ? ' (bạn)' : '' }}</strong><small>{{ u.email }}</small></div></div></td><td>{{ u.joined }}</td><td>{{ u.conversations }}</td><td>{{ u.runs30 }}</td><td>{{ u.tokens30 }}</td><td><button class="small-button {{ u.is_admin ? 'adm-admin-on' : '' }}" disabled="{{ vm['busy'] || u.isMe }}" title="{{ u.isMe ? 'Không thể tự thu quyền của chính bạn' : '' }}" @click(client.toggleAdmin(u))><svg class="i" aria-hidden="true"><use href="#i-shield"></use></svg>{{ u.is_admin ? 'Quản trị' : 'Thành viên' }}</button></td></tr>
                            @endforeach
                        </tbody>
                    </table>
                </div>
                @if(!vm['busy'] && vm['users'].length === 0)<p class="empty-state-text">Không tìm thấy người dùng nào.</p>@endif
            </section>
            @endif

            @if(vm['tab'] === 'limits' && vm['limits'].length)
            <form class="adm-limits" @submit(client.saveLimits(event))>
                <p class="muted adm-lead">Áp dụng ngay cho lượt chạy mới của mọi workspace, kể cả worker đang chạy. Lượt đang chạy giữ hạn mức lúc bắt đầu.</p>
                @foreach(vm['limits'] as group)
                @key(group.id)
                <section class="adm-card">
                    <div class="adm-card-head"><h2>{{ group.title }}</h2></div>
                    <div class="adm-fields">
                        @foreach(group.fields as field)
                        @key(field.key)
                        <label class="adm-field {{ field.changed ? 'changed' : '' }}"><span>{{ field.label }}</span><span class="adm-input"><input type="number" name="{{ field.key }}" value="{{ field.value }}" min="0" step="1" required><em>{{ field.unit }}</em></span><small>{{ field.hint }}</small></label>
                        @endforeach
                    </div>
                </section>
                @endforeach
                <div class="adm-actions"><button type="button" class="small-button" disabled="{{ vm['busy'] }}" @click(client.resetLimits())>Khôi phục mặc định</button><button class="primary-button" disabled="{{ vm['busy'] }}">{{ vm['busy'] ? 'Đang lưu…' : 'Lưu hạn mức' }}</button></div>
            </form>
            @endif
        </div>
    </main>
</div>
@endblock
</template>
